# Copy to .env (git-ignored). Server-side only: never exposed to the browser.
# LI.FI integrator settings (https://docs.li.fi). The web app proxies li.quest
# through /api/lifi so the key stays on the server; scripts read this file too.
LIFI_API_KEY=
# Must match the integrator name registered in the LI.FI partner portal (fees are rejected with 1011 otherwise).
LIFI_INTEGRATOR=
# Optional integrator fee: percentage of every LI.FI transfer (0.25 = 0.25 %) paid to LIFI_FEE_WALLET.
LIFI_FEE_ENABLED=false
LIFI_FEE_PERCENTAGE=
LIFI_FEE_WALLET=

# RouteDust gas faucet (/faucets). All server-side; the faucet stays off until the first four are set.
# A dedicated hot wallet holding only testnet funds: never reuse a key that has ever held real assets.
FAUCET_PRIVATE_KEY=
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → add site; add your domain).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Claim store (Vercel Marketplace → Upstash Redis, or UPSTASH_REDIS_REST_URL / _TOKEN). Required in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: per-chain amounts in native units, "chainId=amount,…" (0 switches a chain off; any registry chain can be added).
FAUCET_AMOUNTS=
# Optional: claims per chain per UTC day across everyone (default 150) and a salt for hashed IPs.
FAUCET_DAILY_CAP=
FAUCET_IP_SALT=
