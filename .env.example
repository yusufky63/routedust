# Copy to .env (git-ignored). Server-side only: never exposed to the browser.
# LI.FI integrator settings (https://docs.li.fi). The web app proxies li.quest
# through /api/lifi so the key stays on the server; scripts read this file too.
LIFI_API_KEY=
# Must match the integrator name registered in the LI.FI partner portal (fees are rejected with 1011 otherwise).
LIFI_INTEGRATOR=
# Optional integrator fee: percentage of every LI.FI transfer (0.25 = 0.25 %) paid to LIFI_FEE_WALLET.
LIFI_FEE_ENABLED=false
LIFI_FEE_PERCENTAGE=
LIFI_FEE_WALLET=
