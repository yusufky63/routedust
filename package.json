{
  "name": "testnet-router",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @testnet-router/web dev",
    "build": "pnpm --filter @testnet-router/web build",
    "start": "pnpm --filter @testnet-router/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "probe": "tsx scripts/probe.ts",
    "discover": "tsx scripts/discover.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "viem": "2.56.6",
    "@testnet-router/registry": "workspace:*",
    "@testnet-router/core": "workspace:*",
    "@testnet-router/providers": "workspace:*"
  },
  "type": "module"
}
